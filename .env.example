# ============================================================================
#  The only thing you need to set.
# ============================================================================
#
#   1. Open any LinkedIn profile in Chrome, DevTools -> Network tab.
#   2. Click a request to /voyager/api/...
#   3. Request Headers -> right-click the `cookie:` value -> Copy value.
#   4. Paste it verbatim below, on one line, with no surrounding quotes.
#
# Lasts months. It dies when you log out, change your password, or if LinkedIn
# revokes the session — then repeat steps 1-4. That is the whole maintenance
# story.
#
LI_COOKIE=

# Check Chrome for which agent is being sent in req or search "my user agent" in google and paste the result here
LI_USER_AGENT=

# ============================================================================
#  Optional
# ============================================================================
PORT=3000

# Only set this if requests start failing after a LinkedIn frontend update.
# Copy `clientVersion` out of a request's x-li-track header. Defaults to 1.13.46243.
# LI_CLIENT_VERSION=

# Optional upstream proxy, e.g. http://user:pass@host:port
# Must be the same egress IP the session was created on, or LinkedIn sees a
# new device and may revoke the session.
PROXY_URL=
